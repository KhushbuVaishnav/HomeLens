# Copy this file's contents into a new file named ".env" (no ".example")
# in the project root, then fill in your real key(s) below.
# .env should NEVER be committed to git — it holds secrets.

# --- API keys (only the one matching AI_PROVIDER below actually needs a real value) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# --- Optional: LangSmith tracing (https://smith.langchain.com) ---
# Off by default — matching_service.py's @traceable calls are a documented
# no-op with zero network activity when LANGSMITH_TRACING isn't set at all.
# To turn it on: sign up at smith.langchain.com, create an API key there,
# paste it below, THEN set LANGSMITH_TRACING=true. Order matters — setting
# TRACING=true before the key is real will print a LangSmithAuthError on
# every scoring call (harmless, doesn't block the actual search, but noisy).
# LANGSMITH_API_KEY=lsv2_pt_your-key-here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=homelens

# --- Which AI provider to use ---
AI_PROVIDER=anthropic
# AI_PROVIDER=openai

# --- Which model, per provider (only the one matching AI_PROVIDER above is used) ---
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_MODEL=gpt-5.6-sol

# --- Which data source to use ---
# live       -> real SimplyRETS sandbox API (small, fixed, Redwood City only)
# sample     -> app/data/sample_listings.json (tiny hand-edited test set)
# realistic  -> app/data/realistic_listings.json (14 hand-written listings)
# generated  -> app/data/generated_listings.json (large generated set)
DATA_SOURCE=generated

# --- How many AI batches run at once (bigger = faster searches) ---
# Don't guess this — watch the "[provider rate limits] ... remaining" lines
# this app prints to your terminal during a search. Lots of headroom left
# with zero retries? Raise this (try 8, then 12, etc.) and re-check. If you
# see "[rate limit] Hit 429, retrying..." lines, you've gone too high.
MAX_CONCURRENT_BATCHES=4

# --- Optional tuning (defaults shown) ---
# BATCH_SIZE=8
# SCORE_THRESHOLD=60
# TEMPERATURE=0.2
# MAX_TOKENS=2000
# CORS_ALLOW_ORIGINS=*
# ^ "*" is fine for local dev only. Once deployed (e.g. to Render), set this
# to your real frontend URL instead, e.g.:
# CORS_ALLOW_ORIGINS=https://your-frontend-name.onrender.com
# Set this as an environment variable in Render's dashboard, not in a
# committed file.

# --- OpenAI-only: reasoning effort ---
# Newer OpenAI models (gpt-5.6 and later) reject a custom TEMPERATURE
# whenever reasoning is active (their default). Set this to "none" to try
# disabling reasoning AND re-enable TEMPERATURE for the OpenAI path — the
# one case OpenAI's docs say that combination might be accepted. Verify
# with: python scripts/verify_test_cases.py --with-ai
# Has no effect on AI_PROVIDER=anthropic.
# OPENAI_REASONING_EFFORT=none
# OPENAI_REASONING_EFFORT=low
# OPENAI_REASONING_EFFORT=medium
# OPENAI_REASONING_EFFORT=high
